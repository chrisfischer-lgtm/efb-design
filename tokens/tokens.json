{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "EFB Design",
    "version": "1.0.0",
    "source": "Measured from the reference TakeOff app (1180 x 820 pt canvas)",
    "unit": "pt"
  },
  "canvas": {
    "width": { "$value": 1180, "$type": "dimension" },
    "height": { "$value": 820, "$type": "dimension" },
    "orientation": { "$value": "landscape" }
  },
  "color": {
    "data": {
      "entered": { "$value": "#48CBFF", "$type": "color", "$description": "Value entered or changed by the pilot" },
      "preselected": { "$value": "#F5E619", "$type": "color", "$description": "Value preselected by the system" },
      "computed": { "$value": "#4FF43D", "$type": "color", "$description": "Computed result or fixed by type" },
      "default": { "$value": "#FFFFFF", "$type": "color", "$description": "Standard value, labels, locked inputs" },
      "caption": { "$value": "#B5B9BF", "$type": "color", "$description": "Unit captions" },
      "warning": { "$value": "#FFA933", "$type": "color", "$description": "No solution, unknown version" },
      "version": { "$value": "#FFB01F", "$type": "color" }
    },
    "fms": {
      "title": { "$value": "#1FF21F", "$type": "color" },
      "value": { "$value": "#4FF43D", "$type": "color" },
      "cyan": { "$value": "#2FD6E8", "$type": "color" },
      "grey": { "$value": "#7F7F7F", "$type": "color" }
    },
    "graph": {
      "path": { "$value": "#1EF0F0", "$type": "color" },
      "tableGreen": { "$value": "#29FF42", "$type": "color" },
      "plot": { "$value": "#000000", "$type": "color" },
      "panel": { "$value": "#595959", "$type": "color" }
    },
    "surface": {
      "chrome": { "$value": "#C8C8C8", "$type": "color" },
      "metalLight": { "$value": "#8A8A89", "$type": "color" },
      "metalDark": { "$value": "#737372", "$type": "color" },
      "metalHome": { "$value": "#A7A7A7", "$type": "color" },
      "card": { "$value": "#434343", "$type": "color" },
      "cardEdge": { "$value": "#292C32", "$type": "color" },
      "cardBevel": { "$value": "#B6B9BF", "$type": "color" },
      "separatorLight": { "$value": "#A1A1A1", "$type": "color" },
      "popover": { "$value": "#757A81", "$type": "color" },
      "popoverEdge": { "$value": "#282C32", "$type": "color" },
      "runway": { "$value": "#0D0D0D", "$type": "color" }
    },
    "text": {
      "slate": { "$value": "#53626B", "$type": "color" },
      "buttonDark": { "$value": "#5E5E5E", "$type": "color" },
      "link": { "$value": "#333333", "$type": "color" },
      "glyph": { "$value": "#555555", "$type": "color" }
    }
  },
  "gradient": {
    "rowSelected": ["#6F879F", "#527694"],
    "entrySelected": ["#6A8198", "#456783"],
    "buttonWhite": ["#FFFFFF", "#FBFBFB", "#D5D7D8"],
    "buttonWhiteDimmed": ["#BCBFC2", "#ADB0B4", "#95999E"],
    "buttonGrey": ["#A1A5A9", "#8A8F95", "#6C7379"],
    "buttonGreyDimmed": ["#C6C9CD", "#B7BABF", "#A3A7AC"],
    "key": ["#FFFFFF", "#F2F3F3", "#DDDEDF"],
    "keyDisabled": ["#BABCC0", "#B0B3B7"],
    "pencil": ["#FFBB2B", "#FF9A2C"],
    "pencilActive": ["#FFFFFF", "#B8E0F4"],
    "segmentActive": ["#5FBBE7", "#3096BC"],
    "runwayTag": ["#52D0FF", "#3698C8"],
    "melStrip": ["#ECECEC", "#BEC0C5"],
    "actionStrip": ["#A9ACB1", "#696F76"],
    "resultHeader": ["#EDEDED", "#B9BCC1"],
    "moduleIdle": ["#E9E9E9", "#B8BBC0"],
    "moduleSelected": ["#A4AAB0", "#7A8590"],
    "computingFrame": ["#BFC2C7", "#8C9095", "#6E7279"],
    "computingInner": ["#55595F", "#44484E"]
  },
  "font": {
    "label": { "family": "Futura-CondensedMedium", "size": 20 },
    "caption": { "family": "Futura-CondensedMedium", "size": 20 },
    "hint": { "family": "Futura-CondensedMedium", "size": 20 },
    "value": { "family": "HelveticaNeue-CondensedBold", "size": 20 },
    "title": { "family": "HelveticaNeue-CondensedBold", "size": 24 },
    "popoverTitle": { "family": "HelveticaNeue-CondensedBold", "size": 20 },
    "buttonPrimary": { "family": "HelveticaNeue-CondensedBold", "size": 21 },
    "buttonSmall": { "family": "HelveticaNeue-CondensedBold", "size": 16 },
    "keyDigit": { "family": "HelveticaNeue-CondensedBold", "size": 30 },
    "keyWord": { "family": "HelveticaNeue-CondensedBold", "size": 26 },
    "entry": { "family": "HelveticaNeue-CondensedBold", "size": 24 },
    "backLink": { "family": "HelveticaNeue", "size": 18 },
    "sectionHeader": { "family": "HelveticaNeue-Bold", "size": 15 },
    "fms": { "family": "Menlo-Bold", "alt": "B612 Mono" }
  },
  "size": {
    "rowHeight": 44,
    "rowHeightCompact": 36,
    "rowPaddingLeading": 10,
    "cardRadius": 8,
    "cardGap": 14,
    "cardInset": 10,
    "popoverWidth": 419,
    "popoverRadius": 4,
    "popoverArrow": [13, 24],
    "popoverX": 262,
    "popoverMinY": 32.5,
    "popoverMaxBottom": 733,
    "keyDigit": [59, 58],
    "keyFunction": [60, 58],
    "keyRadius": 6,
    "pencil": 23,
    "checkmark": [18, 17],
    "chevron": [9, 11]
  },
  "layout": {
    "topBar": { "x": 0, "y": 0, "w": 1180, "h": 86 },
    "inputColumn": { "x": 0, "y": 86, "w": 260, "h": 554 },
    "divider": { "x": 259, "y": 86, "w": 2, "h": 660 },
    "resultPane": { "x": 270, "y": 87, "w": 899, "h": 646.5 },
    "melStrip": { "x": 0, "y": 641, "w": 259, "h": 51 },
    "actionStrip": { "x": 0, "y": 693, "w": 259, "h": 52 },
    "clearButton": { "x": 13.5, "y": 703, "w": 72, "h": 32 },
    "computeButton": { "x": 106, "y": 703, "w": 139.5, "h": 32 },
    "moduleBar": { "x": 0, "y": 746, "w": 1180, "h": 74 },
    "computingOverlay": { "w": 420, "h": 214 }
  },
  "overlay": {
    "tapCatcher": 0.001,
    "dim": 0.45,
    "computingBackdrop": 0.28
  },
  "motion": {
    "computeMinimumSeconds": 3
  }
}
